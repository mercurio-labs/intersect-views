rcore 1;
package intersect.fmea.views version "1";
import model "urn:intersect:fmea:1" as f;
pub fn analysisName(self:f.Analysis)->String = self.name;
pub fn items(self:f.Analysis)->Sequence<f.Item> = Sequence(self.items);
pub fn itemName(self:f.Item)->String = self.name;
pub fn failures(self:f.Item)->Sequence<f.FailureMode> = Sequence(self.failures);
pub fn failureName(self:f.FailureMode)->String = self.name;
pub fn actions(self:f.FailureMode)->Sequence<f.Action> = Sequence(self.actions);
pub fn actionName(self:f.Action)->String = self.name;
pub fn actionStatus(self:f.Action)->String = self.status;
pub fn canRate(self:f.FailureMode)->Bool = true;
pub fn canUpdateAction(self:f.Action)->Bool = true;
fn digit(n:Int32)->String = if n==0 {"0"} else {if n==1 {"1"} else {if n==2 {"2"} else {if n==3 {"3"} else {if n==4 {"4"} else {if n==5 {"5"} else {if n==6 {"6"} else {if n==7 {"7"} else {if n==8 {"8"} else {"9"}}}}}}}}};
fn number(n:Int32)->String = if n<10 {digit(n)} else {if n<100 {digit(n/10)+digit(n%10)} else {if n<1000 {digit(n/100)+digit((n/10)%10)+digit(n%10)} else {"1000"}}};
pub fn risk(self:f.FailureMode)->String = "RPN " + number(self.severity*self.occurrence*self.detection);
pub fn severityStyle(self:f.FailureMode)->String = if self.severity>=8 {"high-severity"} else {""};
