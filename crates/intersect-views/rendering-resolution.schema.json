{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "viewKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "enum": [
        "resolved",
        "unsupported",
        "unmanaged"
      ]
    },
    "selection": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "registrationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^.]+(?:\\.[^.]+)+$"
            },
            "ruleSetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "packageFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "projectionPolicy": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "nested"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "containmentTree"
                    },
                    "edgeRole": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "edgeNotation": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "kind",
                    "edgeRole",
                    "edgeNotation"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "origin": {
              "enum": [
                "explicit",
                "inherited",
                "default"
              ]
            },
            "originBinding": {
              "$ref": "graph.schema.json#/$defs/binding"
            },
            "canonicalRendering": {
              "anyOf": [
                {
                  "$ref": "graph.schema.json#/$defs/binding"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "registrationId",
            "ruleSetId",
            "packageFingerprint",
            "projectionPolicy",
            "origin",
            "originBinding",
            "canonicalRendering"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "origin": {
                    "const": "default"
                  }
                }
              },
              "then": {
                "properties": {
                  "canonicalRendering": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "canonicalRendering": {
                    "$ref": "graph.schema.json#/$defs/binding"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "binding": {
            "$ref": "graph.schema.json#/$defs/binding"
          }
        },
        "required": [
          "code",
          "message",
          "binding"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "viewKey",
    "status",
    "selection",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "resolved"
          }
        }
      },
      "then": {
        "properties": {
          "selection": {
            "type": "object"
          },
          "diagnostics": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unsupported"
          }
        }
      },
      "then": {
        "properties": {
          "selection": {
            "type": "null"
          },
          "diagnostics": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unmanaged"
          }
        }
      },
      "then": {
        "properties": {
          "selection": {
            "type": "null"
          },
          "diagnostics": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
