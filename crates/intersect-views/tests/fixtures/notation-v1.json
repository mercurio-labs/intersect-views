{
  "schemaVersion": 1,
  "id": "harness.custom",
  "shapes": {
    "box": {
      "shape": "rounded",
      "fill": "#e8f0ff",
      "stroke": "#3568b8",
      "radius": 12
    }
  },
  "edges": {
