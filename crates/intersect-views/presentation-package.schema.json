{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^@]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^@]+$"
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "languageFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "requires": {
            "type": "array",
            "items": {
              "enum": [
                "graphics.composition.v1",
                "graphics.text.v1",
                "graphics.anchors.v1",
                "rules.graph.v6",
                "rules.graph.v7",
                "views.rendering.v1",
                "rules.graph.v8",
                "views.routing.v1",
                "views.labelPlacement.v1",
                "views.symbolProperties.v1",
                "graphics.borderAnchor.v1"
              ]
            },
            "maxItems": 64
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^@]+$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^@]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "version",
                "sha256"
              ],
              "additionalProperties": false
            },
            "maxItems": 64
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "kind": {
                  "enum": [
                    "symbolLibrary",
                    "ruleSet",
                    "palette",
                    "notation",
                    "renderingRegistry"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "kind",
                "sha256"
              ],
              "additionalProperties": false
            },
            "maxItems": 64
          }
        },
        "required": [
          "schemaVersion",
          "id",
          "version",
          "language",
          "languageFingerprint",
          "requires",
          "dependencies",
          "resources"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "resources": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "ruleSet"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                }
              },
              "required": [
                "resources"
              ]
            },
            "then": {
              "properties": {
                "requires": {
                  "allOf": [
                    {
                      "contains": {
                        "const": "rules.graph.v8"
                      }
                    },
                    {
                      "contains": {
                        "const": "views.routing.v1"
                      }
                    },
                    {
                      "contains": {
                        "const": "views.labelPlacement.v1"
                      }
                    }
                  ]
                }
              },
              "required": [
                "requires"
              ]
            }
          }
        ]
      },
      "maxItems": 64
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "content"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    }
  },
  "required": [
    "root",
    "manifests",
    "resources"
  ],
  "additionalProperties": false
}
