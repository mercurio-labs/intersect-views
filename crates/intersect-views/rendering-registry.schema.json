{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "registrations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^.]+(?:\\.[^.]+)+$"
          },
          "ruleSetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "projectionPolicy": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "nested"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "containmentTree"
                  },
                  "edgeRole": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "edgeNotation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "kind",
                  "edgeRole",
                  "edgeNotation"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "ruleSetId",
          "projectionPolicy"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "registrations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
