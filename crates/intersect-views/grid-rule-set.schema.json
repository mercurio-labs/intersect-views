{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intersect:views:grid-rule-set",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 8
    },
    "form": {
      "const": "grid"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "grid": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "table"
            },
            "query": {
              "$ref": "grid-query.schema.json"
            },
            "rowLabel": {
              "type": "string",
              "minLength": 1
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "label",
                  "value"
                ],
                "additionalProperties": false
              },
              "maxItems": 30,
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "query",
            "rowLabel",
            "columns"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "matrix"
            },
            "rows": {
              "type": "object",
              "properties": {
                "query": {
                  "$ref": "grid-query.schema.json"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "query",
                "label"
              ],
              "additionalProperties": false
            },
            "columns": {
              "type": "object",
              "properties": {
                "query": {
                  "$ref": "grid-query.schema.json"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "query",
                "label"
              ],
              "additionalProperties": false
            },
            "cells": {
              "type": "object",
              "properties": {
                "related": {
                  "type": "string",
                  "minLength": 1
                },
                "members": {
                  "type": "object",
                  "properties": {
                    "select": {
                      "type": "string",
                      "minLength": 1
                    },
                    "column": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "select",
                    "column",
                    "label"
                  ],
                  "additionalProperties": false
                },
                "edit": {
                  "type": "object",
                  "properties": {
                    "create": {
                      "type": "object",
                      "properties": {
                        "tool": {
                          "type": "string",
                          "minLength": 1
                        },
                        "command": {
                          "type": "string",
                          "minLength": 1
                        },
                        "rowAccepts": {
                          "type": "string",
                          "minLength": 1
                        },
                        "columnAccepts": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "tool",
                        "command",
                        "rowAccepts",
                        "columnAccepts"
                      ],
                      "additionalProperties": false
                    },
                    "delete": {
                      "type": "object",
                      "properties": {
                        "tool": {
                          "type": "string",
                          "minLength": 1
                        },
                        "command": {
                          "type": "string",
                          "minLength": 1
                        },
                        "accepts": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "tool",
                        "command",
                        "accepts"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [],
                  "additionalProperties": false,
                  "minProperties": 1
                }
              },
              "required": [
                "related"
              ],
              "additionalProperties": false,
              "dependentRequired": {
                "edit": [
                  "members"
                ]
              }
            }
          },
          "required": [
            "kind",
            "rows",
            "columns",
            "cells"
          ],
          "additionalProperties": false
        }
      ]
    },
    "projection": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "nested"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "form",
    "id",
    "label",
    "language",
    "grid",
    "projection"
  ],
  "additionalProperties": false,
  "$defs": {}
}
