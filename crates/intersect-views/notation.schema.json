{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intersect:notation:1",
  "title": "Intersect notation profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "shapes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "shapes": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shape",
          "fill",
          "stroke"
        ],
        "properties": {
          "shape": {
            "enum": [
              "rectangle",
              "rounded",
              "ellipse",
              "diamond"
            ]
          },
          "fill": {
            "type": "string",
            "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|neutral|usage|definition|package|transparent)$"
          },
          "stroke": {
            "type": "string",
            "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|neutral|usage|definition|package|transparent)$"
          },
          "radius": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "edges": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line",
          "stroke",
          "startMarker",
          "endMarker"
        ],
        "properties": {
          "line": {
            "enum": [
              "solid",
              "dashed",
              "dotted"
            ]
          },
          "stroke": {
            "type": "string",
            "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|neutral|usage|definition|package|transparent)$"
          },
          "startMarker": {
            "enum": [
              "none",
              "arrow",
              "triangle"
            ]
          },
          "endMarker": {
            "enum": [
              "none",
              "arrow",
              "triangle"
            ]
          }
        }
      }
    },
    "icons": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16
      }
    },
    "styleClasses": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "shape": {
                "enum": [
                  "rectangle",
                  "rounded",
                  "ellipse",
                  "diamond"
                ]
              },
              "fill": {
                "type": "string",
                "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|neutral|usage|definition|package|transparent)$"
              },
              "stroke": {
                "type": "string",
                "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|neutral|usage|definition|package|transparent)$"
              },
              "radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "edge": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "line": {
                "enum": [
                  "solid",
                  "dashed",
                  "dotted"
                ]
              },
              "stroke": {
                "type": "string",
                "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|neutral|usage|definition|package|transparent)$"
              },
              "startMarker": {
                "enum": [
                  "none",
                  "arrow",
                  "triangle"
                ]
              },
              "endMarker": {
                "enum": [
                  "none",
                  "arrow",
                  "triangle"
                ]
              }
            }
          }
        }
      }
    }
  }
}
