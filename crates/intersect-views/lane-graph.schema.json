{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "form": {
      "const": "laneGraph"
    },
    "ruleSet": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "view": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "binding": {
                "$ref": "#/$defs/binding"
              }
            },
            "required": [
              "label",
              "binding"
            ],
            "additionalProperties": false
          }
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "key",
        "name",
        "kind",
        "binding",
        "owners",
        "details",
        "problems"
      ],
      "additionalProperties": false
    },
    "palette": {
      "$ref": "palette.schema.json"
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10000
    },
    "axis": {
      "type": "object",
      "properties": {
        "direction": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "semantic": {
          "const": true
        }
      },
      "required": [
        "direction",
        "semantic"
      ],
      "additionalProperties": false
    },
    "lanes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "$ref": "#/$defs/label"
          },
          "binding": {
            "$ref": "#/$defs/binding"
          },
          "container": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "rule",
          "label",
          "binding",
          "container"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "$ref": "#/$defs/label"
          },
          "binding": {
            "$ref": "#/$defs/binding"
          },
          "lane": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 0,
            "maximum": 499
          },
          "unordered": {
            "type": "boolean"
          },
          "predecessors": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "rule",
          "label",
          "binding",
          "lane",
          "rank",
          "unordered",
          "predecessors"
        ],
        "additionalProperties": false
      }
    },
    "spans": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "step": {
            "type": "string",
            "minLength": 1
          },
          "end": {
            "type": "string",
            "minLength": 1
          },
          "lanes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "step",
          "end",
          "lanes"
        ],
        "additionalProperties": false
      }
    },
    "order": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 500
    }
  },
  "required": [
    "schemaVersion",
    "form",
    "ruleSet",
    "revision",
    "view",
    "palette",
    "problems",
    "axis",
    "lanes",
    "steps",
    "spans",
    "order"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "binding": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "elementId": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "object",
          "properties": {
            "start": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "character": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "line",
                "character"
              ],
              "additionalProperties": false
            },
            "end": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "character": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "line",
                "character"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "elementId",
        "context",
        "uri",
        "range",
        "readOnly"
      ],
      "additionalProperties": false
    },
    "part": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\r\\n\\t]*$"
        },
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "editTool": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "text",
        "binding",
        "editTool"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          },
          "maxItems": 32
        }
      },
      "required": [
        "parts"
      ],
      "additionalProperties": false
    }
  }
}
