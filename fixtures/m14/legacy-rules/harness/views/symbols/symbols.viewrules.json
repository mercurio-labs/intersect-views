{
  "schemaVersion": 7,
  "id": "harness.symbols",
  "label": "Graphical compositions",
  "language": "urn:intersect:harness:1",
  "form": "graph",
  "layout": {
    "strategy": "layered",
    "direction": "RIGHT"
  },
  "symbols": [
    {
      "id": "box",
      "emit": "node",
      "notation": "box",
      "title": "boxTitle",
      "subtitle": "boxKind",
      "compartments": [
        {
          "id": "fields",
          "label": "attributes",
          "rows": "boxFields",
          "rowLabel": "fieldLabel"
        }
      ],
      "ports": {
        "select": "boxPins",
        "rule": "pin"
      },
      "graphic": {
        "definition": "harness.symbols/structured",
        "parameters": {
          "showDoc": {
            "kind": "bool",
            "function": "boxHasFields"
          }
        },
        "slots": {
          "title": {
            "kind": "title"
          },
          "subtitle": {
            "kind": "subtitle"
          },
          "doc": {
            "kind": "text",
            "name": "documentation"
          },
          "compartments": {
            "kind": "compartments"
          }
        },
        "text": {
          "documentation": {
            "runs": [
              {
                "id": "doc",
                "label": "m12Documentation"
              }
            ]
          }
        }
      },
      "match": "Box"
    },
    {
      "id": "pin",
      "emit": "port",
      "label": "pinLabel",
      "side": "pinSide",
      "graphic": {
        "definition": "harness.symbols/terminal",
        "parameters": {
          "facing": {
            "kind": "string",
            "value": "pinSide"
          }
        },
        "slots": {
          "label": {
            "kind": "label"
          }
        },
        "text": {}
      },
      "match": "Pin"
    }
  ],
  "edges": [
    {
      "kind": "element",
      "id": "wire",
      "per": "box",
      "select": "boxLinks",
      "notation": "link",
      "label": "linkLabel",
      "sourcePath": "linkSourcePath",
      "targetPath": "linkTargetPath",
      "anchor": "owner",
      "endMarker": {
        "definition": "harness.symbols/diamond",
        "parameters": {},
        "slots": {},
        "text": {}
      }
    }
  ],
  "projection": {
    "kind": "nested"
  }
}
