space RoutingRegions {
  kind Shared {
    group Left { box Sender { pin outPort : out; field level = 2; } }
    group Blockers { box Obstacle {} }
    group Right { box Receiver { pin inPort : in; } }
    link across { from s (group Left part Sender pin outPort) to t (group Right part Receiver pin inPort) }
  }
  box Alpha : Shared {}
  box Beta : Shared {}
}
