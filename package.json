{
  "name": "@intersect/visualization",
  "version": "0.1.0-m14.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "exports": {
    ".": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "default": "./dist/canvas.js"
    },
    "./canvas.css": "./dist/canvas.css",
    "./palette.schema.json": "./crates/intersect-views/palette.schema.json",
    "./presentation.schema.json": "./crates/intersect-views/presentation.schema.json",
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./scope": {
      "types": "./dist/scope.d.ts",
      "default": "./dist/scope.js"
    },
    "./notation.schema.json": "./crates/intersect-views/notation.schema.json",
    "./grid": {
      "types": "./dist/grid.d.ts",
      "default": "./dist/grid.js"
    },
    "./outline": {
      "types": "./dist/outline.d.ts",
      "default": "./dist/outline.js"
    },
    "./sequence": {
      "types": "./dist/sequence.d.ts",
      "default": "./dist/sequence.js"
    },
    "./view-canvas": {
      "types": "./dist/view-canvas.d.ts",
      "default": "./dist/view-canvas.js"
    },
    "./grid.css": "./dist/grid.css",
    "./worker-host": {
      "types": "./dist/worker-host.d.ts",
      "default": "./dist/worker-host.js"
    },
    "./wasm-worker": {
      "types": "./dist/wasm-worker.d.ts",
      "default": "./dist/wasm-worker.js"
    },
    "./graphics": {
      "types": "./dist/graphics-contract.d.ts",
      "default": "./dist/graphics-contract.js"
    },
    "./graphics-layout": {
      "types": "./dist/graphics-layout.d.ts",
      "default": "./dist/graphics-layout.js"
    },
    "./presentation-package": {
      "types": "./dist/presentation-package.d.ts",
      "default": "./dist/presentation-package.js"
    },
    "./graphics.schema.json": "./crates/intersect-views/graphics.schema.json",
    "./presentation-package.schema.json": "./crates/intersect-views/presentation-package.schema.json",
    "./graph-rule-set.schema.json": "./crates/intersect-views/graph-rule-set.schema.json",
    "./lane": {
      "types": "./dist/lane.d.ts",
      "default": "./dist/lane.js"
    },
    "./lane.css": "./dist/lane.css",
    "./rendering": {
      "types": "./dist/rendering.d.ts",
      "default": "./dist/rendering.js"
    },
    "./rendering-registry.schema.json": "./crates/intersect-views/rendering-registry.schema.json",
    "./rendering-resolution.schema.json": "./crates/intersect-views/rendering-resolution.schema.json",
    "./routing.schema.json": "./crates/intersect-views/routing.schema.json",
    "./presentation-state": {
      "types": "./dist/presentation-state.d.ts",
      "default": "./dist/presentation-state.js"
    },
    "./outline.css": "./dist/outline.css",
    "./sequence.css": "./dist/sequence.css",
    "./graph.schema.json": "./crates/intersect-views/graph.schema.json"
  },
  "files": [
    "dist",
    "crates/intersect-views/*.schema.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "check": "tsc --project packages/visualization/tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test packages/visualization/tests/*.test.ts",
    "test:canvas": "node tools/test_canvas.mjs",
    "dev": "vite",
    "build:harness": "node tools/build_harness.mjs",
    "build:web": "vite build",
    "test:harness": "node harness/web/browser.test.mjs",
    "test:editing": "node harness/web/editing.test.mjs",
    "test:grid": "node harness/web/grid.test.mjs",
    "test:regions": "node harness/web/regions.test.mjs",
    "test:m12": "node harness/web/m12.test.mjs",
    "test:workbench": "node harness/web/workbench.test.mjs",
    "build:fmea": "node tools/build_fmea.mjs",
    "test:fmea": "node languages/fmea/web/browser.test.mjs",
    "test:lanes": "node harness/web/lanes.test.mjs",
    "build:sdk": "tsc --project packages/visualization/tsconfig.sdk.json && node tools/copy_sdk_styles.mjs",
    "prepare": "npm run build:sdk"
  },
  "dependencies": {
    "elkjs": "0.12.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.0",
    "typescript": "5.7.3",
    "vite": "6.4.6"
  }
}
